# PROVISIONAL PROGRAM-LEVEL BASELINE FOR AMD AI LEAGUE MATCH 4
#
# The official MC3 starter kit says the programme shares the same container
# rules across challenges and that MC2/MC3 use this exact ROCm base. Reconfirm
# against the Match 4 kit before tagging the final submission image.
FROM rocm/pytorch:rocm10.0_ubuntu26.04_py3.14_pytorch_release_2.13.0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    AGENT_OUTPUT=/app/output

WORKDIR /app

COPY requirements-runtime.txt /app/requirements-runtime.txt
RUN pip install --no-cache-dir -r /app/requirements-runtime.txt

COPY src/ /app/src/
COPY app/app.py /app/app.py

RUN mkdir -p /app/output

# Programme pattern from MC2/MC3: no HTTP service and no exposed port.
# The grader executes commands inside an already-running container.
CMD ["sleep", "infinity"]
